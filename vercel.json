{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(?:src|scripts|node_modules)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/api/.*\\.js",
      "status": 404
    },
    {
      "src": "/dist(?:/.*)?",
      "status": 404
    },
    {
      "src": "/Idealschool\\.css",
      "status": 404
    },
    {
      "src": "/(?:package(?:-lock)?|tsconfig|database\\.schema|firebase-config\\.example)\\.(?:json|md|js)",
      "status": 404
    },
    {
      "src": "/(?:server|vercel)\\.js(?:on)?",
      "status": 404
    },
    {
      "src": "/api/platform",
      "dest": "/api/platform.js"
    },
    {
      "src": "/runtime",
      "dest": "/dist/app.js"
    },
    {
      "src": "/skin",
      "dest": "/dist/skin.css"
    },
    {
      "src": "/(.*\\.(?:css|js|jpg|jpeg|png|webp|svg|ico|json|txt))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
